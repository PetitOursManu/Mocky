  "scripts": {
    "predev": "npm run vendor:fonts",
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "npm run vendor:fonts && concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "prebuild": "npm run vendor:fonts",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "pretest": "npm run vendor:fonts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:vendor": "node scripts/check-vendor.mjs",
    "vendor:three": "node scripts/build-vendor-three.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "compose:motion": "node scripts/build-motion-compose.mjs",
    "docs:data": "node --experimental-strip-types scripts/build-docs-data.mjs",
    "check:docs-data": "node --experimental-strip-types scripts/check-docs-data.mjs",
    "backup": "node scripts/backup.mjs",
    "docs": "lumy dev --root docs-site --port 4173",
    "docs:build": "lumy build --root docs-site",
    "docs:check": "lumy check --root docs-site"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
