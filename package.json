{
  "name": "mocky",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:vendor": "node scripts/check-vendor.mjs",
    "vendor:three": "node scripts/build-vendor-three.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "compose:motion": "node scripts/build-motion-compose.mjs",
    "docs:data": "node --experimental-strip-types scripts/build-docs-data.mjs",
    "check:docs-data": "node --experimental-strip-types scripts/check-docs-data.mjs",
    "backup": "node scripts/backup.mjs",
    "docs": "lumy dev --root docs-site --port 4173",
    "docs:build": "lumy build --root docs-site",
    "docs:check": "lumy check --root docs-site"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "impeccable": "^3.5.0",
    "motion": "12.43.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "lumy-docs": "https://github.com/PetitOursManu/Lumy/releases/download/v0.1.1/lumy-docs-0.1.1.tgz",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
