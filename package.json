{
  "name": "mocky",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:vendor": "node scripts/check-vendor.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "docs:data": "node --experimental-strip-types scripts/build-docs-data.mjs",
    "check:docs-data": "node --experimental-strip-types scripts/check-docs-data.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "impeccable": "^3.5.0",
    "motion": "12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.7",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
