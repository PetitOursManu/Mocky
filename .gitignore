# dependencies
node_modules

# build output
dist
dist-ssr

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.DS_Store
*.local
.env
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code local config (keep launch.json, ignore local settings)
.claude/settings.local.json

# Local Docker overrides. Compose loads this on top of docker-compose.yml, so a
# committed one would silently follow the repo onto a real deployment — ours
# pins MOCKY_ORIGIN to http://localhost:8787, which is right for a laptop and
# wrong everywhere else.
docker-compose.override.yml

# Backend data (accounts + per-user projects) — never commit user data
server/data/

# Local data backups produced by `npm run backup` — they contain password
# hashes, session tokens and every project. Never commit them.
backups/

# The documentation site: Lumy keeps its sessions, settings and feedback in
# docs-site/.lumy/, and builds beside dist/ before swapping the two.
docs-site/.lumy/
docs-site/.dist.*

# Worktrees that Claude Code sessions create for parallel work: each is a
# checkout of its own, never part of this one.
.claude/worktrees/
