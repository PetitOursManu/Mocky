# Mocky environment variables (copy to .env and fill in)
# This file is git-ignored — never commit real secrets.

# --- SSO: "Sign in with Dashy" (optional) ---
# The same HS256 secret Dashy signs SSO tokens with (must match Dashy's SSO_SHARED_SECRET)
# SSO_SHARED_SECRET=
# The public origin of your Dashy instance
# SSO_DASHY_URL=https://dashy.example.com
# Mocky's own public origin (used as the token's `aud` claim and callback URL)
# MOCKY_ORIGIN=https://mocky.example.com

# --- Server ---
# Which host interface the Docker container publishes its port on.
# 127.0.0.1 (the default) = reachable only from this machine — the right choice
# when Mocky sits behind a reverse proxy, and the safe choice otherwise, because
# several Mocky routes spend your model credits.
# Set 0.0.0.0 to expose it on your LAN. Only do this on a network you trust.
# MOCKY_BIND=127.0.0.1

# Which interface the server itself listens on. DOCKER USERS: leave this alone —
# the image sets 0.0.0.0 because a container that listens on loopback cannot be
# reached through its published port. Use MOCKY_BIND above instead.
# This one is for running Mocky from source (`npm start`), where it defaults to
# 127.0.0.1. Set 0.0.0.0 to reach it from another machine on your network.
# MOCKY_HOST=127.0.0.1

# PORT=8787
# Dev-only: force the backend port so a dev harness that sets PORT (for Vite)
# doesn't push the backend onto Vite's port. Takes precedence over PORT.
# MOCKY_PORT=8787
# NODE_ENV=production

# REQUIRED behind a reverse proxy (Nginx, Caddy, Traefik). Without it every
# request looks like it comes from 127.0.0.1, so the login rate limit becomes a
# single instance-wide bucket: nine failed attempts in a minute and NOBODY can
# sign in, including you. Set to 1 for one proxy hop.
# TRUST_PROXY=1

# Where Mocky keeps its state: accounts, sessions, projects, the image library
# and the video sequences. Defaults to server/data next to the code.
# DOCKER USERS: do not set this. The volume is mounted at /app/server/data, and
# moving the path takes your data straight back out of the volume.
# MOCKY_DATA_DIR=server/data

# Ceiling on the media libraries (images + scroll sequences), in megabytes.
# Defaults to 10240 (10 GB). Past it, uploads and generations answer 507 with a
# clear message instead of filling the volume — which matters because a full
# volume also stops accounts, sessions and projects from being saved, silently.
# Set 0 for no limit if you would rather watch the disk yourself.
# MOCKY_MAX_STORAGE_MB=10240